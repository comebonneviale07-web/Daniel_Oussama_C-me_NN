{
  "id": "m2_regularised",
  "version": "m2/v3_regularised",
  "kind": "mlp",
  "input_size": 64,
  "hidden_sizes": [
    512,
    256,
    128,
    64,
    32
  ],
  "activation": "relu",
  "dropout": 0.0,
  "batch_norm": true,
  "normalization": "training_channel",
  "augmentation": "flip",
  "optimizer": "adamw",
  "weight_decay": 0.01,
  "selection_metric": "val_macro_f1",
  "patience": 8,
  "epochs": 30,
  "lr": 0.0001
}
